---
import { SITE } from '../config';

const links = [
  { href: '/', label: '首页', key: 'home' },
  { href: '/projects/', label: '项目', key: 'projects' },
  { href: '/blog/', label: '博客', key: 'blog' },
  { href: '/about/', label: '关于', key: 'about' },
];

// 高亮当前导航项
const path = Astro.url.pathname;
function isActive(key: string): boolean {
  if (key === 'home') return path === '/' || path === '';
  return path.startsWith(`/${key}`);
}
---

<header class="sticky top-0 z-50 border-b border-(--color-border) bg-(--color-bg)/85 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="font-mono text-sm font-semibold text-(--color-ink) transition-colors hover:text-(--color-accent)">
      <span class="text-(--color-ink-faint)">~/</span>oblivion
    </a>

    <div class="hidden items-center gap-1 sm:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition-colors',
              isActive(link.key)
                ? 'bg-(--color-accent)/10 text-(--color-accent)'
                : 'text-(--color-ink-dim) hover:text-(--color-ink)',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="ml-2 rounded-md p-1.5 text-(--color-ink-dim) transition-colors hover:text-(--color-accent)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97.01 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.2.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换日间/夜间模式"
        class="theme-toggle ml-1 rounded-md p-1.5 text-(--color-ink-dim) transition-colors hover:text-(--color-accent)"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>

    <!-- 移动端菜单 -->
    <div class="flex items-center gap-1 sm:hidden">
      <button
        id="theme-toggle-mobile"
        type="button"
        aria-label="切换日间/夜间模式"
        class="theme-toggle rounded-md p-1.5 text-(--color-ink-dim)"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <details>
        <summary class="list-none cursor-pointer p-2 text-(--color-ink-dim)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </summary>
        <div class="absolute left-0 right-0 top-14 flex flex-col gap-1 border-b border-(--color-border) bg-(--color-bg) p-3">
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'rounded-md px-3 py-2 text-sm',
                  isActive(link.key)
                    ? 'bg-(--color-accent)/10 text-(--color-accent)'
                    : 'text-(--color-ink-dim)',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  function bindToggle(id: string) {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = !root.classList.contains('dark');
      root.classList.toggle('dark', dark);
      try {
        localStorage.setItem('oblivion-theme', dark ? 'dark' : 'light');
      } catch (e) {
        /* 忽略存储失败（如隐私模式） */
      }
    });
  }
  bindToggle('theme-toggle');
  bindToggle('theme-toggle-mobile');
</script>
