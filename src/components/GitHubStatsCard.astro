---
import type { GithubRepo, GithubUser } from '../lib/github';

interface Props {
  user: GithubUser | null;
  repos: GithubRepo[] | null;
}

const { user, repos } = Astro.props;

// 只统计原创公开仓库
const original = repos?.filter((r) => !r.fork) ?? [];
const totalStars = original.reduce((sum, r) => sum + r.stargazers_count, 0);
const topLanguage = (() => {
  const counts = new Map<string, number>();
  for (const r of original) {
    if (r.language) counts.set(r.language, (counts.get(r.language) ?? 0) + 1);
  }
  let best: string | null = null;
  let bestCount = 0;
  for (const [lang, count] of counts) {
    if (count > bestCount) {
      best = lang;
      bestCount = count;
    }
  }
  return best;
})();

const stats = [
  { label: '公开仓库', value: user ? String(user.public_repos) : '—' },
  { label: '原创项目', value: original.length > 0 ? String(original.length) : '—' },
  { label: 'star 总数', value: totalStars > 0 ? String(totalStars) : '—' },
  { label: 'GitHub 关注', value: user ? String(user.followers) : '—' },
];
---

<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
  {
    stats.map((s) => (
      <div class="rounded-lg border border-(--color-border) bg-(--color-panel) px-4 py-5 text-center shadow-sm">
        <p class="font-mono text-2xl font-semibold text-(--color-accent)">{s.value}</p>
        <p class="mt-1 text-xs text-(--color-ink-faint)">{s.label}</p>
      </div>
    ))
  }
</div>

{
  topLanguage && (
    <p class="mt-3 text-center font-mono text-xs text-(--color-ink-faint)">
      使用最多的语言：<span class="text-(--color-ink-dim)">{topLanguage}</span>
      （数据构建时从 GitHub API 同步）
    </p>
  )
}
