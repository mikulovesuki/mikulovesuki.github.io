---
import { fetchEvents, fetchRepos, type GithubEvent, type GithubRepo } from '../lib/github';

const LIMIT = 6;

/** 构建时拉取 GitHub 事件；失败或为空时降级为「最近更新的仓库」 */
const events = (await fetchEvents()) ?? [];
const list = events.slice(0, LIMIT);

let fallback: GithubRepo[] = [];
if (list.length === 0) {
  const repos = await fetchRepos();
  fallback = (repos ?? [])
    .filter((r) => !r.fork && !r.archived)
    .sort((a, b) => b.pushed_at.localeCompare(a.pushed_at))
    .slice(0, LIMIT);
}

const NOW = Date.now();
const timeAgo = (iso: string): string => {
  const t = new Date(iso).getTime();
  const diff = Math.max(0, NOW - t);
  const min = Math.floor(diff / 60000);
  if (min < 1) return '刚刚';
  if (min < 60) return `${min} 分钟前`;
  const h = Math.floor(min / 60);
  if (h < 24) return `${h} 小时前`;
  const d = Math.floor(h / 24);
  if (d < 30) return `${d} 天前`;
  const mo = Math.floor(d / 30);
  if (mo < 12) return `${mo} 个月前`;
  return `${Math.floor(mo / 12)} 年前`;
};

const trunc = (s: string, n = 54) => (s.length > n ? s.slice(0, n) + '…' : s);
const oneLine = (s: string) => s.replace(/\s+/g, ' ').trim();

interface ActivityItem {
  link: string;
  repo: string;
  badge: string;
  color: string;
  text: string;
  time: string;
}

function eventItem(e: GithubEvent): ActivityItem {
  const repo = e.repo.name;
  const p = e.payload || {};
  const base = `https://github.com/${repo}`;
  const time = timeAgo(e.created_at);
  const pick = (t: string) => trunc(oneLine(t || ''), 52);

  switch (e.type) {
    case 'PushEvent': {
      const n = p.commits?.length ?? 0;
      const first = pick((p.commits ?? [])[0]?.message ?? '');
      return {
        link: p.head ? `${base}/commit/${p.head}` : base,
        repo,
        badge: 'push',
        color: '--color-accent',
        text: `推送 ${n} 个提交${first ? ` · "${first}"` : ''}`,
        time,
      };
    }
    case 'CreateEvent': {
      const kind = p.ref_type === 'branch' ? '分支' : p.ref_type === 'tag' ? '标签' : '仓库';
      return { link: base, repo, badge: 'create', color: '--color-accent-2', text: `创建了${kind} ${p.ref ?? ''}`, time };
    }
    case 'WatchEvent':
      return { link: base, repo, badge: 'star', color: '--color-accent-3', text: 'star 了这个仓库', time };
    case 'ForkEvent':
      return { link: base, repo, badge: 'fork', color: '--color-accent-2', text: `fork 了 ${p.forkee?.full_name ?? repo}`, time };
    case 'PullRequestEvent': {
      const pr = p.pull_request;
      if (!pr) return { link: base, repo, badge: 'pr', color: '--color-accent-2', text: '在仓库上有 PR 动态', time };
      const act = p.action === 'opened' ? '提交了' : p.action === 'closed' ? '关闭了' : '更新了';
      return { link: pr.html_url, repo, badge: 'pr', color: '--color-accent-2', text: `${act} PR #${pr.number}：${trunc(oneLine(pr.title), 40)}`, time };
    }
    case 'IssuesEvent': {
      const issue = p.issue;
      if (!issue) return { link: base, repo, badge: 'issue', color: '--color-accent-3', text: '在仓库上有 Issue 动态', time };
      const act = p.action === 'opened' ? '开启了' : p.action === 'closed' ? '关闭了' : '更新了';
      return { link: issue.html_url, repo, badge: 'issue', color: '--color-accent-3', text: `${act} Issue #${issue.number}：${trunc(oneLine(issue.title), 40)}`, time };
    }
    case 'ReleaseEvent': {
      const r = p.release;
      return { link: r?.html_url ?? base, repo, badge: 'release', color: '--color-accent', text: `发布了 release：${r?.name ?? ''}`, time };
    }
    case 'DeleteEvent':
      return { link: base, repo, badge: 'del', color: '--color-ink-faint', text: `删除了${p.ref_type ?? '内容'} ${p.ref ?? ''}`, time };
    default:
      return { link: base, repo, badge: (e.type || 'event').toLowerCase(), color: '--color-accent', text: '有新的动态', time };
  }
}

const items: ActivityItem[] = list.map(eventItem);
const hasActivity = items.length > 0;
---

<section class="rounded-xl border border-(--color-border) bg-(--color-panel) shadow-sm">
  <div class="flex items-center gap-2 border-b border-(--color-border) px-5 py-3.5 font-mono text-xs font-semibold text-(--color-ink)">
    <span class="inline-block h-2 w-2 rounded-sm bg-(--color-accent)"></span>
    GitHub 最新动态
    <span class="ml-auto hidden text-[10px] font-normal text-(--color-ink-faint) sm:block">
      构建时从 GitHub Events API 同步
    </span>
  </div>

  <ul class="divide-y divide-(--color-border)">
    {
      hasActivity ? (
        items.map((it) => (
          <li class="flex flex-col gap-1.5 px-5 py-3.5 sm:flex-row sm:items-center">
            <a
              href={it.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-w-0 flex-1 items-center gap-2.5"
            >
              <span
                class:list={[
                  'shrink-0 rounded px-1.5 py-0.5 font-mono text-[10px] leading-none text-white',
                ]}
                style={`background: var(${it.color})`}
              >
                {it.badge}
              </span>
              <span class="min-w-0">
                <span class="block truncate font-mono text-xs font-semibold text-(--color-ink) transition-colors group-hover:text-(--color-accent)">
                  {it.repo}
                </span>
                <span class="block truncate text-xs text-(--color-ink-dim)">
                  {it.text}
                </span>
              </span>
            </a>
            <span class="shrink-0 font-mono text-[10px] text-(--color-ink-faint) sm:ml-3">
              {it.time}
            </span>
          </li>
        ))
      ) : fallback.length > 0 ? (
        fallback.map((r) => (
          <li class="flex flex-col gap-1.5 px-5 py-3.5 sm:flex-row sm:items-center">
            <a
              href={r.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-w-0 flex-1 items-center gap-2.5"
            >
              <span class="shrink-0 rounded bg-(--color-accent) px-1.5 py-0.5 font-mono text-[10px] leading-none text-white">
                update
              </span>
              <span class="min-w-0">
                <span class="block truncate font-mono text-xs font-semibold text-(--color-ink) transition-colors group-hover:text-(--color-accent)">
                  {r.name}
                </span>
                <span class="block truncate text-xs text-(--color-ink-dim)">
                  {r.description || '最近更新仓库'}
                </span>
              </span>
            </a>
            <span class="shrink-0 font-mono text-[10px] text-(--color-ink-faint) sm:ml-3">
              {r.pushed_at.slice(0, 10)}
            </span>
          </li>
        ))
      ) : (
        <li class="px-5 py-6 text-center text-xs text-(--color-ink-faint)">
          动态拉取暂时失败了，稍后再来看看～
        </li>
      )
    }
  </ul>
</section>
