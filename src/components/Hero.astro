---
import katex from 'katex';

// 构建时渲染 KaTeX（零客户端 JS）
const formulas = [
  katex.renderToString('A = Q \\Lambda Q^{\\mathsf{T}}', { throwOnError: false }),
  katex.renderToString('e^{i\\pi} + 1 = 0', { throwOnError: false }),
  katex.renderToString('\\int_a^b f(x)\\,dx \\approx \\tfrac{h}{3}\\big(y_0 + 4y_1 + 2y_2 + \\cdots \\big)', {
    throwOnError: false,
  }),
  katex.renderToString('\\lambda_1 \\ge \\lambda_2 \\ge \\cdots \\ge \\lambda_n', { throwOnError: false }),
  katex.renderToString('E = \\int_0^T |P(t)|\\,dt', { throwOnError: false }),
  katex.renderToString('\\lim_{n \\to \\infty} A^n \\mathbf{x}', { throwOnError: false }),
];

const positions = [
  'top-[12%] left-[4%]',
  'top-[28%] right-[8%]',
  'top-[55%] left-[10%]',
  'top-[70%] right-[5%]',
  'top-[42%] left-[42%]',
  'top-[85%] left-[58%]',
];

// 打字机文案由下方 <script> 提供
---

<section class="relative overflow-hidden border-b border-(--color-border)">
  <!-- 漂浮公式背景 -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.12]">
    {
      formulas.map((f, i) => (
        <span
          class:list={['formula-float absolute font-serif text-lg text-(--color-accent-2)', positions[i]]}
          style={`animation-delay: ${i * 1.2}s`}
          set:html={f}
        />
      ))
    }
  </div>

  <div class="relative mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-28">
    <!-- 终端窗口 -->
    <div class="fade-up mx-auto max-w-2xl overflow-hidden rounded-xl border border-(--color-border) bg-(--color-code-bg) shadow-2xl shadow-black/40">
      <div class="flex items-center gap-2 border-b border-(--color-border) bg-(--color-panel) px-4 py-2.5">
        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
        <span class="ml-3 font-mono text-xs text-(--color-ink-faint)">oblivion@local — zsh</span>
      </div>
      <div class="min-h-[16rem] p-5 font-mono text-sm leading-7 sm:text-[15px]">
        <p class="text-(--color-ink-dim)"><span class="text-(--color-accent)">$</span> whoami</p>
        <p class="text-(--color-ink)">oblivion</p>

        <p class="mt-3 text-(--color-ink-dim)"><span class="text-(--color-accent)">$</span> cat about.txt</p>
        <p class="text-(--color-accent-2)">
          <span id="typing-text"></span><span class="typing-cursor text-(--color-accent)">▍</span>
        </p>

        <p class="mt-3 text-(--color-ink-dim)"><span class="text-(--color-accent)">$</span> ls ~/projects</p>
        <p class="grid grid-cols-1 gap-x-6 text-(--color-ink) sm:grid-cols-2">
          <span><span class="text-(--color-accent-3)">ai/</span> mimo-vision-mcp</span>
          <span><span class="text-(--color-accent-3)">ai/</span> intelligent-travel-assistant</span>
          <span><span class="text-(--color-accent-3)">ai/</span> math-rag-assistant</span>
          <span><span class="text-(--color-accent-3)">num/</span> matrix-eigenvalue-methods</span>
          <span><span class="text-(--color-accent-3)">num/</span> robot-arm-energy-analysis</span>
          <span class="text-(--color-ink-faint)"><span class="text-(--color-accent-3)">…</span> more</span>
        </p>

        <p class="mt-3 text-(--color-ink-dim)">
          <span class="text-(--color-accent)">$</span>
          <span class="typing-cursor text-(--color-accent)">▍</span>
        </p>
      </div>
    </div>

    <!-- CTA -->
    <div class="fade-up mt-10 flex flex-wrap items-center justify-center gap-4" style="animation-delay: 0.3s">
      <a
        href="/projects/"
        class="rounded-lg bg-(--color-accent) px-5 py-2.5 text-sm font-semibold text-(--color-bg) transition-transform hover:scale-105"
      >
        查看项目 →
      </a>
      <a
        href="/blog/"
        class="rounded-lg border border-(--color-border) px-5 py-2.5 text-sm text-(--color-ink-dim) transition-colors hover:border-(--color-accent) hover:text-(--color-accent)"
      >
        阅读博客
      </a>
    </div>

    <p class="mt-12 text-center font-serif text-lg italic text-(--color-ink-dim)">
      “<span class="text-(--color-accent)">从公式到工程</span>”——把数学推演变成能跑起来的系统
    </p>
  </div>
</section>

<script>
  // 打字机效果
  const text = 'AI 应用开发 · 数值计算 · 数学建模';
  const el = document.getElementById('typing-text');
  if (el && typeof window !== 'undefined') {
    let i = 0;
    const type = () => {
      if (i <= text.length) {
        el.textContent = text.slice(0, i);
        i++;
        setTimeout(type, 90);
      }
    };
    // 延迟启动，与页面加载错开
    setTimeout(type, 600);
  }
</script>
