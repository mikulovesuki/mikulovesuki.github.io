---
// 打字机文案由下方 <script> 提供
---

<section class="relative overflow-hidden border-b border-(--color-border)">
  <!-- 背景板：二次元黄昏雨景（public/img/hero-dusk.jpg），CSS 见 global.css -->
  <div aria-hidden="true" class="hero-sky absolute inset-0"></div>
  <!-- 文字可读性遮罩 -->
  <div aria-hidden="true" class="hero-overlay absolute inset-0"></div>

  <!-- 缓慢漂移的雾层（原云层效果，适应黄昏雨景） -->
  <div aria-hidden="true" class="hero-cloud" style="top: 14%; left: -220px; width: 320px; height: 64px; animation-duration: 75s;"></div>
  <div aria-hidden="true" class="hero-cloud" style="top: 26%; left: -340px; width: 440px; height: 80px; animation-duration: 95s; animation-delay: -30s;"></div>
  <div aria-hidden="true" class="hero-cloud" style="top: 8%; left: -260px; width: 260px; height: 52px; animation-duration: 65s; animation-delay: -12s;"></div>
  <div aria-hidden="true" class="hero-cloud" style="top: 38%; left: -300px; width: 300px; height: 56px; animation-duration: 85s; animation-delay: -55s; opacity: 0.8;"></div>

  <div class="relative mx-auto flex min-h-[540px] max-w-5xl flex-col items-center justify-center px-4 text-center sm:min-h-[600px]">
    <h1 class="hero-title fade-up text-4xl font-semibold tracking-wide text-white sm:text-5xl">
      oblivion
    </h1>

    <p class="hero-sub fade-up mt-4 font-mono text-sm text-white/95 sm:text-base" style="animation-delay: 0.15s">
      <span id="typing-text"></span><span class="typing-cursor">▍</span>
    </p>

    <a
      href="https://github.com/mikulovesuki"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="fade-up mt-8 flex h-11 w-11 items-center justify-center rounded-full bg-white/25 text-white backdrop-blur-sm transition-colors hover:bg-white/40"
      style="animation-delay: 0.3s"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97.01 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.2.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
      </svg>
    </a>

    <!-- 下拉提示 -->
    <div aria-hidden="true" class="chevron-down absolute bottom-5 text-white/90">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </div>
  </div>
</section>

<script>
  // 打字机效果
  const text = 'AI 应用开发 · 数值计算 · 数学建模';
  const el = document.getElementById('typing-text');
  if (el && typeof window !== 'undefined') {
    let i = 0;
    const type = () => {
      if (i <= text.length) {
        el.textContent = text.slice(0, i);
        i++;
        setTimeout(type, 90);
      }
    };
    // 延迟启动，与页面加载错开
    setTimeout(type, 600);
  }
</script>
