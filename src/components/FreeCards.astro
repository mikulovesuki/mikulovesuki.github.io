---
import type { FreeCard } from '../lib/site-data';

interface Props {
  cards: FreeCard[];
}

const { cards } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2">
  {
    cards.map((card) => (
      <div class="flex flex-col rounded-xl border border-(--color-border) bg-(--color-panel) p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-(--color-accent)/50 hover:shadow-md">
        <h3 class="font-serif text-lg font-semibold text-(--color-ink)">
          {card.title}
        </h3>
        <p class="mt-2 flex-1 whitespace-pre-wrap text-sm leading-6 text-(--color-ink-dim)">
          {card.body}
        </p>
        {
          card.link && (
            <a
              href={card.link}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 font-mono text-xs text-(--color-accent) transition-opacity hover:opacity-75"
            >
              {card.link} ↗
            </a>
          )
        }
      </div>
    ))
  }
</div>
