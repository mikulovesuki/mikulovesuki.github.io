---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCloud from '../components/SkillCloud.astro';
import Timeline from '../components/Timeline.astro';
import GitHubStatsCard from '../components/GitHubStatsCard.astro';
import RecentActivity from '../components/RecentActivity.astro';
import { getMergedProjects } from '../lib/site-data';
import { fetchAll } from '../lib/github';

// 构建时同步 GitHub 数据（失败时降级为 null，页面仍可用）
const { user, repos } = await fetchAll();
const repoStats = new Map((repos ?? []).map((r) => [r.name, r]));

const starOf = (name: string) => repoStats.get(name)?.stargazers_count ?? 0;
const updatedOf = (name: string) => {
  const pushed = repoStats.get(name)?.pushed_at;
  if (!pushed) return undefined;
  return pushed.slice(0, 10); // YYYY-MM-DD
};

// 项目数据 = 默认数据 + 管理后台编辑数据（site-data.json）
const mergedProjects = getMergedProjects();
const featured = mergedProjects.filter((p) => p.featured);
const others = mergedProjects.filter((p) => !p.featured);
---

<BaseLayout>
  <Hero slot="hero" />

  <!-- 精选项目 -->
  <section id="projects" class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="mb-8 flex items-end justify-between">
      <div>
        <p class="font-mono text-xs text-(--color-accent)">## 精选项目</p>
        <h2 class="mt-2 font-serif text-2xl font-bold text-(--color-ink)">
          做了些什么 <span class="text-(--color-ink-faint)">—</span> 有量化验证、有测试、有文档
        </h2>
      </div>
      <a href="/projects/" class="hidden shrink-0 font-mono text-sm text-(--color-ink-dim) transition-colors hover:text-(--color-accent) sm:block">
        全部项目 →
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {featured.map((p) => (
        <ProjectCard project={p} starCount={starOf(p.repo)} updatedAt={updatedOf(p.repo)} />
      ))}
    </div>
    <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {others.map((p) => (
        <ProjectCard project={p} starCount={starOf(p.repo)} updatedAt={updatedOf(p.repo)} />
      ))}
    </div>
  </section>

  <!-- 每日动态：GitHub 最新活动（构建时同步） -->
  <RecentActivity />

  <!-- GitHub 数据 -->
  <section class="border-y border-(--color-border) bg-(--color-bg-soft)">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
      <p class="mb-6 text-center font-mono text-xs text-(--color-accent)">## github stats</p>
      <GitHubStatsCard user={user} repos={repos} />
    </div>
  </section>

  <!-- 技能 -->
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="mb-8">
      <p class="font-mono text-xs text-(--color-accent)">## 技能栈</p>
      <h2 class="mt-2 font-serif text-2xl font-bold text-(--color-ink)">
        三条主线 <span class="text-(--color-ink-faint)">—</span> AI 应用 / 数值计算 / 学术工具链
      </h2>
    </div>
    <SkillCloud />
  </section>

  <!-- 时间线 -->
  <section class="border-t border-(--color-border)">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <div class="mb-8">
        <p class="font-mono text-xs text-(--color-accent)">## 成长轨迹</p>
        <h2 class="mt-2 font-serif text-2xl font-bold text-(--color-ink)">
          一年半，从 LaTeX 到 MCP
        </h2>
      </div>
      <Timeline />
    </div>
  </section>
</BaseLayout>
